{
  "info": {
    "name": "Card Imports",
    "description": "Coleccion Postman para iniciar una importacion de cartas y consultar su progreso.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:80"
    },
    {
      "key": "processId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Iniciar importacion",
      "request": {
        "method": "POST",
        "header": [],
        "description": "Inicia una importacion asincrona. Devuelve 202 Accepted con el snapshot inicial del proceso o 409 Conflict si ya hay una importacion activa.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/card-imports",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "card-imports"]
        }
      },
      "response": []
    },
    {
      "name": "Consultar estado de importacion",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Consulta el estado, progreso, contadores, fechas y posible error del proceso. Devuelve 404 Not Found si el processId no existe.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/card-imports/{{processId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "card-imports", "{{processId}}"]
        }
      },
      "response": []
    }
  ]
}
