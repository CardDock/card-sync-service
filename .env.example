# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://[USER]:[YOUR-PASSWORD]@[HOST]:[PORT]?sslmode=require&channel_binding=require"

# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Application port (default: 80)
PORT=80

# Card import source and MongoDB target
YGOPRODECK_API_BASE_URL="https://db.ygoprodeck.com/api/v7/cardinfo.php"
CARD_IMPORT_DATA_DIRECTORY="data"
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="yugioh-cards"